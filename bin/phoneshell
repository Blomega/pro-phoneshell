#!/usr/bin/env bash
# Thin wrapper so you can run `bin/phoneshell doctor` from anywhere.
#
# It also creates the virtualenv on first use. A fresh clone has no .venv, and
# the published quickstart opens with `bin/phoneshell doctor`, so without this
# the very first command a new user runs dies on "no such file or directory".
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"

PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  # Pick a modern interpreter explicitly. `python3` on macOS is the 3.9 that
  # ships with the Command Line Tools, and half of these dependencies refuse to
  # install on it, so taking whatever `python3` happens to be fails on a Mac that
  # has a perfectly good 3.13 sitting next to it.
  BOOT=""
  for v in 3.14 3.13 3.12 3.11; do
    if command -v "python$v" >/dev/null 2>&1; then BOOT="$(command -v "python$v")"; break; fi
  done
  if [ -z "$BOOT" ]; then
    echo "phoneshell needs Python 3.11 or newer (found: $(python3 -V 2>&1 || echo none))." >&2
    echo "  brew install python@3.13" >&2
    exit 1
  fi
  echo "first run: creating the virtualenv with $($BOOT -V 2>&1)" >&2
  "$BOOT" -m venv "$ROOT/.venv"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$ROOT/requirements.txt"
  echo "ready" >&2
fi
# Importable from any working directory (an MCP client or another tool may
# start this from anywhere); relative paths in arguments still mean the caller's.
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m phoneshell.cli "$@"
