# Everything the rig produces stays local. runtime/ holds the device UDID, the
# signing team, screenshots of a real phone, an audit log of every tap, and the
# learned screen memory (which includes the account name shown in Settings).
# None of it is publishable, so the whole directory is excluded rather than
# picked over file by file.
runtime/

.venv/
build/
vendor/WebDriverAgent/
__pycache__/
*.pyc
*.egg-info/
.DS_Store

# site/index.html and site/results.json are generated, never hand-edited, but they
# ARE committed: the blog bot deploys site/ from a fresh clone, and without them
# blolabel.ai served a 404 homepage from 2026-09-21 to 2026-09-30.
.wrangler/

# Local code-graph cache from the graphify tool. Generated, machine-specific,
# and 3MB of AST JSON: useful here, noise in a published repo.
graphify-out/

# The held-out task split. A benchmark whose entire answer key is public becomes
# training data, so these never leave this machine.
environments-private/

# Collected screenshots are a run artifact and belong to the phone's owner.
runtime/crawls/
